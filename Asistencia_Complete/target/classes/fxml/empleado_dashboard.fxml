<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="8" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="pe.edu.upeu.asistencia.controller.EmpleadoController" prefWidth="700" prefHeight="550">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <Label text="Panel Empleado" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
    <Label fx:id="lblNombre" text="Empleado: " />
    <Label fx:id="lblHorario" text="Horario: " />

    <Separator />
    <Label text="Registrar Entrada/Salida" />
    <Button fx:id="btnEntradaSalida" text="Registrar Entrada/Salida" onAction="#registrarEntradaSalida" />

    <Separator />
    <Label text="Solicitar Vacaciones" />
    <HBox spacing="8">
        <Label text="Inicio:" /><DatePicker fx:id="dpInicio" />
        <Label text="Fin:" /><DatePicker fx:id="dpFin" />
        <Button text="Solicitar" onAction="#solicitarVacacion" />
    </HBox>

    <Separator />
    <Label text="Mis solicitudes:" />
    <TableView fx:id="tablaVac" prefHeight="140">
        <columns>
            <TableColumn fx:id="colInicio" text="Inicio" />
            <TableColumn fx:id="colFin" text="Fin" />
            <TableColumn fx:id="colEstado" text="Estado" />
        </columns>
    </TableView>

    <Separator />
    <Label text="Mi historial de asistencia:" />
    <TableView fx:id="tablaAsist" prefHeight="140">
        <columns>
            <TableColumn fx:id="colFechaEntrada" text="Entrada" />
            <TableColumn fx:id="colFechaSalida" text="Salida" />
        </columns>
    </TableView>

    <Button text="Volver al Login" onAction="#volverLogin" />
</VBox>
