<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="8" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="pe.edu.upeu.asistencia.controller.AdminController" prefWidth="800" prefHeight="600">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <Label text="Panel Admin - Gestión de Usuarios, Horarios y Vacaciones" style="-fx-font-size:14px; -fx-font-weight:bold;"/>

    <HBox spacing="10">
        <VBox spacing="6">
            <Label text="Registrar nuevo empleado:" />
            <TextField fx:id="nombreField" promptText="Nombre completo" />
            <TextField fx:id="usuarioField" promptText="Usuario" />
            <PasswordField fx:id="passField" promptText="Contraseña" />
            <Button text="Registrar empleado" onAction="#registrarEmpleado" />
        </VBox>

        <VBox spacing="6" prefWidth="450">
            <Label text="Empleados registrados:" />
            <TableView fx:id="tablaUsuarios" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" />
                    <TableColumn fx:id="colUsuario" text="Usuario" />
                    <TableColumn fx:id="colRol" text="Rol" />
                </columns>
            </TableView>

            <Label text="Asignar horario al empleado seleccionado (HH:MM):" />
            <HBox spacing="6">
                <TextField fx:id="horarioInicioField" promptText="09:00" />
                <TextField fx:id="horarioFinField" promptText="18:00" />
                <TextField fx:id="diasField" promptText="LUN-MAR-..." />
                <Button text="Asignar Horario" onAction="#asignarHorario" />
            </HBox>
        </VBox>
    </HBox>

    <Separator />

    <Label text="Bandeja de Vacaciones pendientes:" />
    <TableView fx:id="tablaVacPendientes" prefHeight="180">
        <columns>
            <TableColumn fx:id="colEmp" text="Empleado" />
            <TableColumn fx:id="colInicio" text="Inicio" />
            <TableColumn fx:id="colFin" text="Fin" />
            <TableColumn fx:id="colEstado" text="Estado" />
        </columns>
    </TableView>

    <HBox spacing="8">
        <Button text="Aceptar solicitud" onAction="#aceptarVacacion" />
        <Button text="Rechazar solicitud" onAction="#rechazarVacacion" />
        <Button text="Volver al Login" onAction="#volverLogin" />
    </HBox>
</VBox>
